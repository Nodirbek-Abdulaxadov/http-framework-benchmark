// jwc-app benchmark — updated for JWC v0.8.0.
//
// v0.4.0 closed the two gaps that previously forced workarounds:
//   * /json-large now builds the 1000-object array per request with array
//     literals + push (true parity with the other stacks), instead of the
//     old precompute-once-and-cache string-concat trick.
//   * /cpu now runs real SHA-256 like every other stack, instead of the LCG
//     arithmetic substitute.
//
// v0.4.6 (Phase 7) adds the TechEmpower-shape DB tier — `/db`, `/queries`,
// `/updates` — against a single-table `World(id, randomNumber)` schema
// seeded with 10,000 rows. These exercise the v0.4.4 V::RawJson fast path
// for `select first` and the v0.4.5 atomic `update CTX.Table set ...`
// codegen, so they're real cross-stack comparables, not micro-benchmarks.
//
// v0.8.0 brings compound assignment (`+=`) and the ternary operator, both used
// below. The rest of the 0.7/0.8 surface doesn't apply here: no FK columns to
// `index`, no join table to `unique(a, b)`, no frontend to move onto the new
// `code`/`details` error envelope, and every `where` binds a `@param` rather
// than a literal, so the pre-0.8 `and`/`or` literal-RHS bug never hit it.

dbcontext BenchDb : Postgres;

entity World of BenchDb {
    id          int pk;
    randomNumber int;
}

route GET "/ping" {
    return "pong";
}

route GET "/json-small" {
    return json({
        id: 1,
        name: "Test",
        active: true
    });
}

// Build an array of 1000 objects per request and serialize it — same workload
// as the other frameworks (loop + serialize). Array literal + push are v0.4.0.
route GET "/json-large" {
    let items = [];
    let i = 0;
    while (i < 1000) {
        push(items, { id: i, name: "Item " + i, value: i * 10 });
        i += 1;
    }
    return json(items);
}

// CPU-bound workload: 100,000 chained SHA-256 hashes, matching the other
// stacks (~30 ms/req with SHA-NI). v0.4.0 added a native sha256() builtin.
route GET "/cpu" {
    let h = "seed";
    let i = 0;
    while (i < 100000) {
        h = sha256(h);
        i += 1;
    }
    return h;
}

route GET "/async-delay" {
    await sleep_ms(10);
    return "ok";
}

// -------------------- DB tier --------------------
//
// Workloads modeled on the TechEmpower /db, /queries, /updates shapes. The
// World table is seeded with 10,000 rows by `migrations/<ts>_init-bench.up.sql`.
//
// Row IDs come from a per-request seed so consecutive requests don't all hit
// the same prepared-statement cache row. The seed is `ss * 1000 + mmm` pulled
// out of now()'s ISO-8601 string ("2026-07-28T06:36:44.521Z" → 44521), which
// spans 0..59999 and therefore covers the full 1..10000 id range six times
// over. The other stacks use their native RNG for the same purpose — the
// per-request DB work is identical, only the id source differs. now() +
// substring() + int() are all supported by the native backend; the
// unix_timestamp() this replaced was not, which is what broke
// `jwc build --native`.

route GET "/db" {
    let t = now();
    let seed = int(substring(t, 17, 2)) * 1000 + int(substring(t, 20, 3));
    let id = seed % 10000 + 1;
    let row = select World from BenchDb.World where World.id == @id first;
    return json(row);
}

route GET "/queries" {
    let raw = query_param("queries", "20");
    let n = int(raw);
    let n2 = n < 1 ? 1 : (n > 500 ? 500 : n);
    let t = now();
    let seed = int(substring(t, 17, 2)) * 1000 + int(substring(t, 20, 3));
    let out = [];
    let i = 0;
    while (i < n2) {
        let id = (seed * 7919 + i * 104729) % 10000 + 1;
        let r = select World from BenchDb.World where World.id == @id first;
        push(out, r);
        i += 1;
    }
    return json(out);
}

// NOTE: the natural form of this route —
//
//     update BenchDb.World set randomNumber = new_val where World.id == @id;
//
// does not work in a `jwc build --native` binary as of v0.8.0. The native
// codegen emits `jwc_param_str` for the SET value (`jwc_param_bigint` when it is
// a literal), so writing to an `int` (int4) column always fails to serialize.
// `raw_sql` is the escape hatch: it binds `V::Int` params as int4 correctly. It
// takes exactly two arguments — the SQL and a JSON array *string* of positional
// params — so the values have to be formatted into that string by hand. See
// JWC-0.8.0-NATIVE-BUGS.md for the full write-up.
route GET "/updates" {
    let raw = query_param("queries", "20");
    let n = int(raw);
    let n2 = n < 1 ? 1 : (n > 500 ? 500 : n);
    let t = now();
    let seed = int(substring(t, 17, 2)) * 1000 + int(substring(t, 20, 3));
    let out = [];
    let i = 0;
    while (i < n2) {
        let id = (seed * 7919 + i * 104729) % 10000 + 1;
        let new_val = (seed * 31 + i * 17) % 10000 + 1;
        raw_sql("UPDATE world SET randomnumber = $1 WHERE id = $2",
                "[" + new_val + "," + id + "]");
        let r = select World from BenchDb.World where World.id == @id first;
        push(out, r);
        i += 1;
    }
    return json(out);
}

function main() {
    // No-arg form: pulls DATABASE_URL (or PG_HOST/PORT/USER/PASSWORD/DATABASE)
    // from the env. `.env` is auto-loaded before main() runs. The DB tier
    // (/db, /queries, /updates) requires this to be wired before serve().
    setConnectionString();
    serve(8080);
}
